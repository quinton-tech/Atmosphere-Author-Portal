{
  "name": "author-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server --env-file=.env src/db/seed.ts",
    "sync:hubspot": "tsx --conditions=react-server --env-file=.env src/lib/hubspot/run-sync.ts",
    "assistant:eval": "tsx --conditions=react-server --env-file=.env src/lib/assistant/eval/run.ts",
    "team:import": "tsx --conditions=react-server --env-file=.env src/lib/team/run-import.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/openai": "^4.0.57",
    "@ai-sdk/react": "^4.0.94",
    "@auth/drizzle-adapter": "^1.11.3",
    "@hubspot/api-client": "^14.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.2.0",
    "ai": "^7.0.91",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^178.0.0",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "otplib": "^13.5.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
