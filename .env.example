# --- Core ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
APP_NAME="Atmosphere Author Portal"

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Atmosphere Press <portal@atmospherepress.com>"

# --- HubSpot Private App. Scopes: crm.objects.contacts.read, crm.objects.custom.read, crm.schemas.custom.read,
#     plus crm.objects.contacts.write (or crm.objects.custom.write if contact fields live on the Project)
#     ONLY for the author self-service contact-info update in src/lib/hubspot/writes.ts ---
HUBSPOT_ACCESS_TOKEN=
# Custom object type id or fully qualified name for the Project object, e.g. 2-12345678 or p_project
HUBSPOT_PROJECT_OBJECT_TYPE=

# --- Google Drive (service account, drive.readonly) ---
# Base64 of the service-account JSON key
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Author uploads (write-scoped, separate from the read-only Drive account) ---
# A SECOND Google service account, distinct from the read-only one above. Share the master author
# folder with its client_email as Editor so author uploads land in the author's own folder; it uses
# the full `drive` scope, so sharing is what bounds its reach. GOOGLE_UPLOADS_ROOT_FOLDER_ID is the
# fallback tree for authors with no folder yet.
# src/lib/drive/uploads.ts is the only module allowed to write to Drive; see docs/DEPLOY.md.
# All optional — /uploads is simply unavailable until configured.
GOOGLE_UPLOADS_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_UPLOADS_ROOT_FOLDER_ID=
# Staff inbox notified (via Resend) whenever an author sends a file.
UPLOADS_NOTIFY_EMAIL=

# --- Assistant providers (set any subset; unset providers are hidden in admin) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Ops ---
CRON_SECRET=change-me
# First admin account; created by `npm run db:seed`
ADMIN_BOOTSTRAP_EMAIL=

# --- Demo ---
# "1" or "true" to run a credential-free preview: HubSpot sync is skipped (cron returns
# immediately), Drive reads are served from public/demo/ fixtures instead of a real service
# account, and the author's own contact-info edits only update the local cache. Combine with
# `npm run db:seed -- --demo` (or just set DEMO_MODE before seeding) to create the fixture
# admin/author/books. See docs/DEMO.md.
DEMO_MODE=
